        {
          "id": "0af17555-8b72-45df-a5f4-a0fa3992473b",
          "name": "Get the Responses in the specified Question",
          "request": {
            "name": "Get the Responses in the specified Question",
            "description": {
              "content": "For coded responses the keys of the applied codes are returned for each response.\r\n\r\nThese keys can be matched to the keys of the codes returned in a query for the codebook to find the details of each of the applied codes.\r\n\r\n\r\nThe optional date query parameters are UTC date/time values.\r\n\r\nThese should be specified in the form:\r\n\r\nYYYY-MM-DDThh:mm:ss\r\n\r\nWhere the hour ranges from 0 to 23.  For example:\r\n\r\n2020-02-23T16:05:17\r\n\r\nIf the time portion of the date/time value is omitted it is assumed to be 00:00:00 GMT.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Responses",
                ":questionKey"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "includeText",
                  "value": "false",
                  "description": "If true, the text of each Response is returned.\r\n\r\n            If false or omitted the text is not returned."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "If omitted, all Responses for the Question are returned.\r\n\r\nIf present, one of these values:\r\n<ul><li>coded: return only Responses with at least one Code applied.\r\n</li><li>uncoded: return only Responses with no Code applied.</li></ul>"
                },
                {
                  "disabled": false,
                  "key": "codedAfter",
                  "value": "<dateTime>",
                  "description": "If present, only responses with a code applied on or after the specified date/time are returned."
                },
                {
                  "disabled": false,
                  "key": "codedBefore",
                  "value": "<dateTime>",
                  "description": "If present, only responses with a code applied before the specified date/time are returned."
                },
                {
                  "disabled": false,
                  "key": "loadedAfter",
                  "value": "<dateTime>",
                  "description": "If present, only responses loaded on or after the specified date/time are returned."
                },
                {
                  "disabled": false,
                  "key": "loadedBefore",
                  "value": "<dateTime>",
                  "description": "If present, only responses loaded before the specified date/time are returned."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "questionKey",
