          "name": "Retrieves a current status of specified job",
          "request": {
            "name": "Retrieves a current status of specified job",
            "description": {
              "content": "This method expects a job key as an input parameter from the **[POST] /Exports** method.\r\n\r\nIt returns information about current status of exporting of the job or result.\r\n\r\nIf the job is not yet completed, the method should be called again after a delay.\r\n\r\nContinue calling this method until the job is either completed or rejected due to an error.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Exports",
                ":jobKey"
              ],
              "host": [
                "{{baseUrl}}"
